# Mac/local preview. Copy values into your shell only when overrides are needed.
GEOCHEM_PROFILE=development
GEOCHEM_HOST=127.0.0.1
GEOCHEM_PORT=8765
GEOCHEM_OPEN_BROWSER=true
GEOCHEM_WEB_WORKERS=1
GEOCHEM_TASK_BACKEND=local
GEOCHEM_STORAGE_ROOT=geochem-data
GEOCHEM_AUTH_MODE=disabled
GEOCHEM_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
GEOCHEM_ALLOWED_HOSTS=127.0.0.1,localhost
GEOCHEM_MAX_UPLOAD_MB=512
GEOCHEM_REQUEST_RATE_PER_MINUTE=300
GEOCHEM_CHAT_RATE_PER_MINUTE=40
GEOCHEM_UPLOAD_RATE_PER_HOUR=20
GEOCHEM_MAX_CONCURRENT_TASKS_PER_USER=3
