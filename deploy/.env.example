# Copy this file to deploy/.env. That file is ignored by Git.
# Passwords used inside URLs should be URL-safe (letters, numbers, underscore,
# and hyphen) or percent-encoded.

GEOCHEM_IMAGE=geochem:lan
GEOCHEM_SITE_HOST=geochem.lan
GEOCHEM_AUTH_HOST=auth.geochem.lan
GEOCHEM_HTTP_PORT=80
GEOCHEM_HTTPS_PORT=443
GEOCHEM_LOG_LEVEL=info
# Docker keeps at most 5 x 20 MiB of stdout/stderr logs per container.
GEOCHEM_LOG_MAX_SIZE=20m
GEOCHEM_LOG_MAX_FILES=5
GEOCHEM_WEB_WORKERS=2
# The Web container is reachable only from the private Compose network, so it
# can trust Caddy's forwarded headers. API documentation stays off in production.
GEOCHEM_FORWARDED_ALLOW_IPS=*
GEOCHEM_ENABLE_API_DOCS=false
GEOCHEM_WORKER_CONCURRENCY=2
GEOCHEM_TASK_TIME_LIMIT_SECONDS=7200
GEOCHEM_TASK_SOFT_TIME_LIMIT_SECONDS=6900
GEOCHEM_TASK_VISIBILITY_TIMEOUT_SECONDS=7500
GEOCHEM_TASK_RESULT_EXPIRES_SECONDS=86400
GEOCHEM_DB_POOL_SIZE=5
GEOCHEM_DB_MAX_OVERFLOW=5
GEOCHEM_DB_POOL_TIMEOUT=30
GEOCHEM_MAX_UPLOAD_MB=512
# User-scoped abuse protection. Redis is mandatory in the production profile.
GEOCHEM_REQUEST_RATE_PER_MINUTE=300
GEOCHEM_CHAT_RATE_PER_MINUTE=40
GEOCHEM_UPLOAD_RATE_PER_HOUR=20
GEOCHEM_MAX_CONCURRENT_TASKS_PER_USER=3
GEOCHEM_VECTOR_ENABLED=true
GEOCHEM_INSTALL_VECTOR=true
GEOCHEM_QDRANT_COLLECTION=geochem_evidence_v1
GEOCHEM_QDRANT_API_KEY=
GEOCHEM_EMBEDDING_MODEL=BAAI/bge-m3
GEOCHEM_EMBEDDING_BATCH_SIZE=8
GEOCHEM_EMBEDDING_MAX_TOKENS=512

POSTGRES_SUPERUSER_PASSWORD=replace-with-a-long-random-password
GEOCHEM_DB_PASSWORD=replace-with-a-long-url-safe-password
KEYCLOAK_DB_PASSWORD=replace-with-a-long-url-safe-password
REDIS_PASSWORD=replace-with-a-long-url-safe-password
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=replace-with-a-long-random-password
# Least-privilege service account used by GeoChem's in-app user management.
KEYCLOAK_ADMIN_API_CLIENT_SECRET=replace-with-a-long-random-password
# First GeoChem application administrator. The password is used only when the
# realm user does not exist; later deployments never reset an existing user.
GEOCHEM_INITIAL_ADMIN_USERNAME=geochem-admin
GEOCHEM_INITIAL_ADMIN_PASSWORD=replace-with-a-long-random-password
GEOCHEM_INITIAL_ADMIN_EMAIL=

# AES-256-GCM master key for model credentials is generated into
# deploy/secrets/credential_master_key by scripts/server-bootstrap.sh. It is
# mounted as a Docker secret and must never be copied into this environment.

# Persistent local SSD directories on the Ubuntu host.
GEOCHEM_DATA_PATH=/srv/geochem/data
POSTGRES_DATA_PATH=/srv/geochem/postgres
REDIS_DATA_PATH=/srv/geochem/redis
QDRANT_DATA_PATH=/srv/geochem/qdrant
CADDY_DATA_PATH=/srv/geochem/caddy/data
CADDY_CONFIG_PATH=/srv/geochem/caddy/config

# Shared server-side model keys. Leave unused providers empty.
OPENCODE_GO_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
MIMO_API_KEY=
OPENROUTER_API_KEY=

# Backup configuration. Mount the NAS before running the backup job.
GEOCHEM_NAS_MOUNT=/mnt/nas
RESTIC_REPOSITORY=/mnt/nas/geochem-restic
RESTIC_PASSWORD_FILE=/etc/geochem/restic-password
BACKUP_RETENTION_DAILY=7
BACKUP_RETENTION_WEEKLY=5
BACKUP_RETENTION_MONTHLY=12
